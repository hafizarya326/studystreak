{
  "name": "time-saver",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=scripts/.verify.mjs && node scripts/.verify.mjs",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=esm --jsx=automatic --outfile=scripts/.smoke.mjs && node --import ./scripts/jsdom-setup.mjs scripts/.smoke.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
